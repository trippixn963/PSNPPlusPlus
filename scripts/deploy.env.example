# Copy to scripts/deploy.env and fill in. That file is gitignored — this one is
# published, so it must never contain a real host, key path, or domain.
#
# release.sh sources scripts/deploy.env if it exists; anything already set in
# the environment wins, so CI can pass these in instead of using a file.

# Where to publish. Any target `scp` understands.
PSNPPP_VPS="user@your-server.example"

# SSH key for that host. Defaults to ~/.ssh/id_ed25519 when unset.
PSNPPP_SSH_KEY="$HOME/.ssh/id_ed25519"

# Public origin the built script points at. Must match @downloadURL/@updateURL
# in userscript/banner.txt, or installs will poll a URL you do not publish to.
PSNPPP_BASE_URL="https://your-domain.example"

# Where the artifacts are served from. Give them a directory of their own —
# NOT a document root another project deploys over. A full-sync deploy
# (rsync --delete) of a co-tenant will delete them, and Tampermonkey reads the
# resulting 404 as "no update available", so every install silently freezes on
# old code while reporting itself up to date.
PSNPPP_WEBROOT="/var/www/psnppp"

# The publish guard's pristine copy, which it restores the web root from.
# Keep it outside any writable path of an internet-facing service.
PSNPPP_PRISTINE="/var/lib/psnppp/published"
