# Verifies (and repairs) the PSNP++ install/auto-update URL. See psnppp-guard.sh
# for why an unmonitored userscript URL is a silent single point of failure.
[Unit]
Description=PSNP++ publish guard — keep the install/auto-update URL serving
After=network-online.target
Wants=network-online.target

# Push, not pull. systemd starts this on ANY non-zero exit — including failures
# the guard cannot report itself, such as ExecStart being missing or
# non-executable (203/EXEC). Without it the only signal is
# `systemctl list-units --failed`, which nobody runs, and the whole point of the
# guard is that the thing it watches fails silently.
#
# MUST live in [Unit]. systemd accepts an OnFailure= in [Service] by parsing it,
# warning to the journal, and IGNORING it — so the alert never fires and nothing
# in the running system says so. Caught by `systemd-analyze verify`; run that
# after editing this file.
OnFailure=psnppp-guard-alert.service

[Service]
Type=oneshot
# No SuccessExitStatus= or Restart= on purpose. A non-zero exit must leave this
# unit in `systemctl list-units --failed`, which Type=oneshot gives for free and
# which is the only passive signal until an alert webhook exists. Note it is a
# LEVEL signal, not an edge one: the next successful run 15 minutes later clears
# it, so a flapping failure can disappear before anyone looks.
ExecStart=/usr/local/sbin/psnppp-guard
TimeoutStartSec=180

# Healthy runs write NOTHING to the journal.
#
# This fires 96 times a day and each run produced four lines — systemd's
# Starting/Finished/Deactivated plus the script's own "OK" — for 474 lines a
# day of "nothing happened". LogLevelMax=notice drops everything below notice,
# including systemd's own unit chatter, so a quiet guard is genuinely silent
# and `journalctl -u psnppp-guard` shows only the runs that MEANT something.
#
# Nothing is lost: repairs log at warning and failures at err, both above the
# threshold. Liveness is still visible without the journal — `systemctl
# list-timers psnppp-guard.timer` shows LAST and NEXT.
LogLevelMax=notice

# This runs as root on a timer forever, on a box that also serves other people's
# services. Its sibling psnppp.service carries the same block.
# ProtectHome is NOT set: it would hide nothing we need today, but ProtectHome=true
# would break the pristine read if that ever moves back under /root.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/psnppp /var/lib/psnppp
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
