# Copy to /etc/psnppp/alert.env on the server, mode 600, root-owned.
# NEVER commit the real file — this repo is public and a webhook URL is a
# credential: anyone holding it can post to that channel.
#
#   install -d -m 755 /etc/psnppp
#   printf 'PSNPPP_ALERT_WEBHOOK=%s\n' "<url>" > /etc/psnppp/alert.env
#   chmod 600 /etc/psnppp/alert.env
#
# Leave it unset or absent and alerting is simply off — psnppp-alert.sh says so
# in the journal and exits 0, rather than failing and needing its own alert.
PSNPPP_ALERT_WEBHOOK=
